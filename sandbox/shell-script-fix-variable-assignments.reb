;; </math operation>

;; <variable no-braces>
;; [$][a-zA-Z_][a-zA-Z0-9_]+
;; </variable>
;; <variable no-braces>
;; [$][{][a-zA-Z_][a-zA-Z0-9_]+[}]
;; </variable braces>
;; <variable>
[$]\\([a-zA-Z_][a-zA-Z0-9_]+\\|[{][a-zA-Z_][a-zA-Z0-9_]+[}]\\)
;; </variable>
;; \\([$]\\([a-zA-Z_][a-zA-Z0-9_]+\\|[{][a-zA-Z_][a-zA-Z0-9_]+[}]\\)\\|\\(\\(0[x]\\|16[#]\\)[a-fA-F0-9]+\\)\\|\\(0\\|\\(8[#]\\)?[0-7]+\\)\\|\\(10[#][0-9]+\\)\\|\\(2[#][01]+\\)\\)
"^\\(\\s-*\\)?\\([a-zA-Z_][a-zA-Z0-9_]*\\)=\\(\\(\".*?\"\\)\\|\\('.*?'\\)\\|\\([0-9]+\\)\\|\\([$]((\\s-*\\(\\(\\s-*[/*^%+^-]\\s-*\\)?\\s-*\\([$]\\([a-zA-Z_][a-zA-Z0-9_]+\\|[{][a-zA-Z_][a-zA-Z0-9_]+[}]\\)\\|\\(\\(0[x]\\|16[#]\\)[a-fA-F0-9]+\\)\\|\\(0\\|\\(8[#]\\)?[0-7]+\\)\\|\\(10[#][0-9]+\\)\\|\\(2[#][01]+\\)\\)\\s-*\\(\\s-*[/*^%+^-]\\s-*\\)?\\)*\\s-*))\\)\\)"
