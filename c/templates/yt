#!/usr/bin/env bash
. ~/.shell.d/x.d/workbench.sh

set -o pipefail
set -o errexit # or -e
# set -o noglob # or -f
set -o errtrace # or set -E
set -o functrace # or set -T
set -o nounset # -u
# set -o errtrace # or set -E # If set, the ERR trap is inherited by shell functions.
# set -o functrace # or set -T # f set, the DEBUG and RETURN traps are inherited by shell functions.
set -u
export IFS=$'\n'

declare -- script_name="$(basename "${BASH_SOURCE[0]}")"
declare -- script_path="$(2>/dev/random 1>/dev/random cd $(dirname "${BASH_SOURCE[0]}") && pwd)"
declare -- this_script_path="${script_path}/${script_name}"
export PS4='${BASH_SOURCE}:${BASH_LINENO[0]} '
declare -- stdin_is_terminal=$([ -t 0 ] && echo "yes" || echo "no")
declare -a argv=($@)
declare -i argc=${#argv[@]}
declare -i script_pid=$$
declare -- iso_timestamp=$(date --iso-8601=seconds)
declare -a exit_messages=()
declare -a urls_to_download=()
declare -A urls_added=()
declare -- logs_path=$(workbench logs)/yt-dlp
mkdir -p "${logs_path}"
declare -- state_path=${logs_path}/${script_name}-${script_pid}
