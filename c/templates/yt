}

process_argv() {
    local -i lineno=0
    if [ ! -t 0 ]; then
        export IFS=$'\n'
        while read line; do
            if ! add_url "${line}"; then
                continue
            fi
        done < /dev/stdin
    elif [ ${argc} -eq 0 ]; then
        exit_error "missing arguments: <URL> [URL...]"
        exit 1
    fi
    for index in ${!argv[@]}; do
        arg=${argv[$index]}
        if ! add_url "${arg}"; then
            continue
        fi
    done

}

main() {
    for url in ${urls_to_download[@]}; do
        local -- slug=$(slugify-string "$(sed -E 's,https?://,,g' <<< "${url}")")
        local -- logs_base="${logs_path}/${slug}"
        local -- stderr="${logs_base}.stderr"
        local -- stdout="${logs_base}.stdout"
        local -- pidfile="${logs_base}.pid"
        local -i yt_dlp_pid=0
        1>${stdout} 2>${stderr} yt-dlp "${url}" < /dev/stdin &
        yt_dlp_pid=$!
        echo "${yt_dlp_pid}" > ${pidfile}
        disown ${yt_dlp_pid}
        1>&2 echo -e "
\x1b[1;38;5;249menqueued url\x1b[1;38;5;231m ${url}      \x1b[0m
\x1b[1;38;5;249m         pid\x1b[1;38;5;201m ${yt_dlp_pid} \x1b[0m
\x1b[1;38;5;249m    pid file\x1b[1;38;5;153m ~${pidfile##${HOME}}  \x1b[0m
\x1b[1;38;5;249m stdout logs\x1b[1;38;5;154m ~${stdout##${HOME}}   \x1b[0m
\x1b[1;38;5;249m stderr logs\x1b[1;38;5;196m ~${stderr##${HOME}}   \x1b[0m
"
    done
}

if [ "${0}" == "${BASH_SOURCE[0]}" ]; then
    process_argv ${argv[@]}
    main
else
    1>&2 echo -e "${BASH_SOURCE[0]} appears to being used as a library by ${0@Q}"
fi
